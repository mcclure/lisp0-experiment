# Takes 1 command line argument [default 10] and runs fizzbuzz up to that number.

# AppArg: 20
# Expect: 1 2 Fizz 4 Buzz Fizz 7 8 Fizz Buzz 11 Fizz 13 14 Fizzbuzz 16 17 Fizz 19 Buzz

# Usage while {conditional} {case}
set-fn 'while {_while_cond, _while_body} {} {
	if (do _while_cond) {
		do _while_body
		while _while_cond _while_body
	}
}

# Fizzbuzz up to command line argument [default 10 if absent]
set 'at 0
set 'target (get args 0)

if target {
	set 'target (to-int target) # ARGV is strings...
} else {
	set 'target 10              # No ARGV
}

set-fn '=0 {x} {} { = 0 x }

while {< at target} {
	set 'at (+ at 1)
	set 'three (=0 (% at 3))
	set 'five (=0 (% at 5))
	print (if three {
		if five {
			"Fizzbuzz"
		} else {
			"Fizz"
		}
	} else {
		if five {
			"Buzz"
		} else {
			at
		}
	}) sp
}
print ln