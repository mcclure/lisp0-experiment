# TODO: DUPLICATE IN NON-LISP
# Check if functions are being called
# Expect: 1 2
# Expect: 3 4
# Expect: A 1 m1
# Expect: B 1 1 - 1 2
# Expect: C 1 o1 | 1 o2
# Expect: D 4 p1
# Expect: 0 1
# Expect: 2 3
# Expect: 8 9

# No args

(set 'do-print '(
	(set 'z x)
	(print z sp y ln)
))

(set 'x 1)
(set 'y 2)
(do-print)

(set 'x 3)
(set 'y 4)
(do-print)

# Args
# TODO: Consider simplifying these

(set-fn 'print-arg0 '(&) nil '(
	(print sp (len args) sp (get args 0))
))

# Make sure to always test one call in and one out of tail recursion position
(set 'print-arg0-wrap '(
	(print-arg0 1)
	(print sp "-")
	(print-arg0 2)
))

(set-fn 'print-arg0-wrap-2 '(&) '() '(
	(print-arg0 (get args 0))
	(print sp "|")
	(print-arg0 (get args 1))
))

(print "A")
(print-arg0 'm1)
(print ln "B")
(print-arg0-wrap 'n1 'n2)
(print ln "C")
(print-arg0-wrap-2 'o1 'o2)
(print ln "D")
(print-arg0 'p1 'p2 'p3 'p4)
(print ln)

# Args -- "higher order"

(set-fn 'print-minus '(&) '() '(
	(print (- (get args 0) 1) sp (- (get args 1) 1) ln)
))

(set-fn 'pass-on-minus '(&) '() '(
	((get args 0) (- (get args 1) 1) (- (get args 2) 1))
))

(set-fn 'pass-on-minus-2 '(&) '() '(
	((get args 0) (- (get args 1) 1) (- (get args 2) 1))
	((get args 0) (- (get args 1) 2) (- (get args 2) 2))
))

# Test basic args...
(print-minus 1 2)

# Test args in nested call...
(pass-on-minus print-minus 4 5)

# Test args restore after call...
(pass-on-minus print-minus 10 11)
