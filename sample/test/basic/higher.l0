# Test "higher-order" builtins
# Expect: No arg 0
# Expect: No arg[3] No arg[2] 0
# Expect: 105
# Expect: No arg 0
# Expect: Arg 4
# Expect: Arg 1 10
# Expect: Arg 2 20
# Expect: Arg 3 30
# Expect: 106

set 'noarg {
	print "No arg " (len args) ln
}

set 'noarg2 {
	print "No arg[2] " (len args) ln
	return 105
}

set 'noarg3 {
	print "No arg[3] "
	do noarg2
}

set 'argprint {
	print "Arg " (len args) ln
	print "Arg 1 " (get args 0) ln
	print "Arg 2 " (get args 1) ln
	print "Arg 3 " (get args 2) ln
	return 106
}

do noarg

print (do noarg3) ln

apply do [return noarg]

print (apply argprint [return 10, return 20, return 30, return 40]) ln
