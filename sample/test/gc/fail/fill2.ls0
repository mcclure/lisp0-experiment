(set 'root (make-array))
(set 'last root)

(set 'recurse '(
	# Add a bit to the tree
	(set 'temp1 (make-array))
	(push root temp1)
	(push last temp1)

	(set 'last temp1)

	(recurse)
))

(recurse)
