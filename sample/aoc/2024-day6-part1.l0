# Advent of Code 2025, day 6, part 1 -- solution

# AppArg: sample/aoc/data/sample.txt
# Expect: Steps: 45 Visited: 41

# Usage while {conditional} {case}
set-fn 'while {_while_cond, _while_body} {} {
	if (do _while_cond) {
		do _while_body
		while _while_cond _while_body
	}
}

# Helpers -- flow control -- 2

# Usage for 'varname from to {case} step
set-fn 'for '(_for_var  _for_from  _for_to  _for_case  _for_step) {_for_scope} {
	if (! _for_step) {
		set '_for_step \
			(if (<  _for_from  _for_to) {1} {-1})
	}

	set '_for_scope (make-dict) # To inject
	set _for_scope _for_var _for_from

	while {!=  (get  _for_scope  _for_var)  _for_to} {
		do  _for_scope  _for_case # Injects var
		set  _for_scope  _for_var  (+ (get  _for_scope  _for_var) _for_step)
	}
}

set-fn 'match '(_match_key _match_table _match_default) '(_match_at _match_to _match_result _match_line) {
	set '_match_at 0
	set '_match_to (len _match_table)
	set '_match_result nil

#	print (get (get _match_table 0) 0) ln

	while {&& (! _match_result) (< _match_at _match_to)} {
		set '_match_line (get _match_table _match_at)
#		print "tst" _match_line sp _match_key sp (get _match_line 0) sp "?" (= _match_key (get _match_line 0)) ln
		if (= _match_key (get _match_line 0)) {
			set '_match_result (get _match_line 1)
		} {
			set '_match_at (+ _match_at 1)
		}
	}

	if _match_result {
		do _match_result
	} {
		if _match_default {
			do _match_default
		}
	}
}

# Vectors

set-fn 'v '(x y) '() { [x, y] }

set-fn 'v+ '(a b) '() {
	v \
		(+ (get a 0) (get b 0)) \
		(+ (get a 1) (get b 1))
}

set-fn 'vneg '(v) '() {
	v (neg (get v 0)) (neg (get v 0))
}

set-fn 'v= '(a b) '() {
	&& \
		(= (get a 0) (get b 0)) \
		(= (get a 1) (get b 1))
}

set-fn 'vstr '(v) '() {
	+ "[" (get v 0) ", " (get v 1) "]"
}

# Program

inset args '(arg-file arg-debug-verbose arg-debug)

if (< (len args) 1) {
	fail "No arguments" ln
}

# Constants

set 'RIGHT   0
set 'UP      1
set 'DOWN    2
set 'LEFT    3
set 'FREE    4
set 'VISITED 5
set 'WALL    6

set 'DIRS [
	v  1  0
	v  0 -1
	v -1  0
	v  0  1
]

set 'CHARS '(> ^ < v . X)
push CHARS "#" # Oops, hard to escape #

# Interpret debug args
if arg-debug-verbose {
	set 'arg-debug-verbose (!= arg-debug-verbose "0")
	set 'arg-debug true
} {
	if arg-debug { set 'arg-debug (!= arg-debug "0") }
}

# Vars

set 'x-len nil
set 'g-at nil
set 'g-dir nil
set 'g-visit 0
set 'g-step 0

set 'board []

# Input

file-in arg-file

while {
	set 'line (read-line)
	line
} {
	set 'line-len (len line)

	if (> line-len 0) {
		if (! x-len) {
			set 'x-len line-len
		} {
			if (!= line-len x-len) {
				fail "Lines of inconsistent length (" line-len ", " x-len ")"
			}
		}

		set-fn 'guard-found '(tmp-dir) '() {
			if g-dir {
				fail "Multiple guards"
			} {
				set 'g-dir tmp-dir
				set 'g-at (v x (len board))
			}
		}

		# This line is good, parse it
		set 'line-tile []
		for 'x 0 line-len {
			set 'char (get line x)

			set 'tile (match char [
				[".", {FREE}]
				["#", {WALL}]

				[">", {
					guard-found RIGHT
					FREE
				}]

				["v", {
					guard-found DOWN
					FREE
				}]

				["<", {
					guard-found LEFT
					FREE
				}]

				["^", {
					guard-found UP
					FREE
				}]
			] {
				fail "Unrecognized character " char
			})

			push line-tile tile
		}
		push board line-tile
	}
}

file-in nil

if (! g-at) {
	fail "Guard not found in file"
}

if arg-debug {
	print "Board: " x-len " x " (len board) ln
	print "Guard: " (get CHARS g-dir) sp (vstr g-at) ln
}

set-fn 'board-print {
	for 'y 0 (len board) {
		for 'x 0 x-len {
			if (v= g-at (v x y)) {
				print (get CHARS g-dir)
			} {
				set 'tile (get (get board y) x)
				print (get CHARS tile)
			}
		}
		print ln
	}
}

set-fn 'board-in '(v) '() {
	&& \
		(<= 0 (get v 0))           \
		(<= 0 (get v 1))           \
		(>  x-len       (get v 0)) \
		(>  (len board) (get v 1))
}

set-fn 'board-get '(b) '() {
	get (get board (get b 1)) (get b 0)
}

set 'searching (board-in g-at)

# One iteration of this loop is one step of the guard
while {return searching} {
	if arg-debug-verbose {
		print ln "  -- step" sp g-step ln ln
		board-print
	}

	# One iteration of this loop is one compass direction checked
	set 'step-success nil
	set 'step-tried 0

	while {&& (! step-success) (< step-tried 4)} {
		set 'step-at (v+ g-at (get DIRS g-dir))

		if arg-debug-verbose { print "Try: " (vstr step-at) sp }

		if (! (board-in step-at)) {
			if arg-debug-verbose { print "OUT" }

			# Case: We have escaped the board.
			# Don't update the board or guard, just quit.
			set 'step-success true
			set 'searching nil
		} {
			set 'step-tile (board-get step-at)
			if (= step-tile WALL) {
				if arg-debug-verbose { print "ROT " }

				# Case: Our candidate space is occupied. Rotate.
				set 'g-dir (% (+ g-dir 7) 4) # We use euler angles, the problem doesn't
			} {
				if arg-debug-verbose { print "SUCCESS" }

				# Case: candidate space unoccupied
				set 'step-success true
				set 'g-at step-at

				if (= step-tile FREE) {
					# Case: The space has never been visited before.
					set 'g-visit (+ g-visit 1)
					set (get board (get g-at 1)) (get g-at 0) VISITED
				}
			}
		}

		if arg-debug-verbose { print ln }

		# Only try 4 times then give up.
		set 'step-tried (+ step-tried 1)
	}

	if (! step-success) {
		fail "Guard trapped?"
	}

	set 'g-step (+ g-step 1) # For debugging
}

if (&& arg-debug (! arg-debug-verbose)) { board-print }
if arg-debug { print ln }

print "Steps: " g-step " Visited: " g-visit ln
