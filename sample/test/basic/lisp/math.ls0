# (Expects interleaved)
# Note: In addition to math this is currently the only good test of unicode string behavior in the test suite

# --- ARITHMETIC
# Expect: 6 7 38
# Expect: 6
# Expect: 1
# Expect: 0 9 -10 -5

(print 6 sp (+ 1 6) sp (+ (+ 2 (+ 1 5)) (+ 10 20)) ln)
(print (* (- 7 4 1) (+ 1 (/ 16 4 2))) ln) # Reduces to (* 2 3)
(print (% 16 5) ln)
(print (+ 1 -1) sp (- -1 -10) sp (* 5 -2) sp (/ -10 2) ln)

# --- BITS
# Expect: -5 5 11 7

(print (neg 5) sp (neg -5) sp (& 15 (~ 4)) sp (| 3 6) ln)

# --- LOGIC
# Expect: [nil] [true] [nil] [nil] [true]
# Expect: [true] [nil] [nil] [true] [nil] [true]

(print (&& true nil) sp (|| nil true) sp (&& true nil true) sp (|| nil nil nil) sp (! nil) ln)
(print (^^ nil true) sp (^^ nil nil) sp (^^ true true) sp (^^ true nil) sp (^^ true nil true) sp (^^ true true true) ln)

# --- EQUALITY
# Expect: [nil] [true]
# Expect: [true] [nil]
# Expect: [nil] [true]
# Expect: [true] [nil]
# Expect: [nil] [true]
# Expect: [true] [nil] [nil]

(print (= 1 3) sp (!= 1 3) ln)
(print (= 1 1) sp (!= 1 1) ln)
(print (= "aye" "bee") sp (!= "aye" "bee") ln)
(print (= "cee" "cee") sp (!= "dee" "dee") ln)
(print (= 1 "1") sp (!= 1 "1") ln)
(print (= 1 1 1) sp (= 1 2 3 4) sp (= 1 1 1 2) ln)

# --- COMPARISON -- INTS
# Expect: [true] [true] [nil] [nil]
# Expect: [nil] [nil] [true] [true]
# Expect: [nil] [true] [nil] [true]

(print (< 4 5) sp (<= 4 5) sp (> 4 5) sp (>= 4 5) ln)
(print (< 9 2) sp (<= 9 2) sp (> 9 2) sp (>= 9 2) ln)
(print (< 7 7) sp (<= 7 7) sp (> 7 7) sp (>= 7 7) ln)

# --- COMPARISON -- STRINGS
# Expect: [true] [true] [nil] [nil]
# Expect: [nil] [nil] [true] [true]
# Expect: [nil] [true] [nil] [true]

(print (< 'd 'e) sp (<= 'd 'e) sp (> 'd 'e) sp (>= 'd 'e) ln)
(print (< 'i 'b) sp (<= 'i 'b) sp (> 'i 'b) sp (>= 'i 'b) ln)
(print (< 'g 'g) sp (<= 'g 'g) sp (> 'g 'g) sp (>= 'g 'g) ln)

# --- COMPARISON -- STRINGS -- MULTIBYTE
# Expect: [true] [true] [nil] [nil]
# Expect: [nil] [nil] [true] [true]
# Expect: [nil] [true] [nil] [true]

(print (< 'ade 'aed) sp (<= 'ade 'aed) sp (> 'ade 'aed) sp (>= 'ade 'aed) ln)
(print (< 'aib 'abi) sp (<= 'aib 'abi) sp (> 'aib 'abi) sp (>= 'aib 'abi) ln)
(print (< 'agh 'agh) sp (<= 'agh 'agh) sp (> 'agh 'agh) sp (>= 'agh 'agh) ln)

# --- COMPARISON -- STRINGS -- UNICODE 2-BYTE
# Expect: [nil] [nil] [true] [true]
# Expect: [true] [true] [nil] [nil]
# Expect: [nil] [true] [nil] [true]
(print (< '四 '五) sp (<= '四 '五) sp (> '四 '五) sp (>= '四 '五) ln) # 4 is greater than 5?
(print (< '九 '二) sp (<= '九 '二) sp (> '九 '二) sp (>= '九 '二) ln) # 2 is greater than 9??
(print (< '七 '七) sp (<= '七 '七) sp (> '七 '七) sp (>= '七 '七) ln) # Unicode Consortium wyd

# --- COMPARISON -- STRINGS -- UNICODE 3-BYTE
# Thank you to Blue Shell Strike Force for sample strings
# Expect: [nil] [nil] [true] [true]
# Expect: [true] [true] [nil] [nil]
# Expect: [nil] [true] [nil] [true]
(print (< '生 '死) sp (<= '生 '死) sp (> '生 '死) sp (>= '生 '死) ln) # Life is greater than death
(print (< '善 '恶) sp (<= '善 '恶) sp (> '善 '恶) sp (>= '善 '恶) ln) # Evil is greater than good?
(print (< '天 '天) sp (<= '天 '天) sp (> '天 '天) sp (>= '天 '天) ln) # Heaven is heaven

# --- STRINGS
# Expect: 123 45

(print (+ "1" "2" "3") sp (+ "4" 5) ln)
# (print '2 sp (+ '2 3) ln) # TODO: Expect: 2 23

# --- ODDITIES AND SHORT CIRCUITING
# Expect: 3 [nil]
# Expect: [true] [true] [nil]
# Expect: trip-a trip-b

(print (return 3) sp (discard 3 4 5 3 4) ln)

# TODO make arg 3 an array

(print (&& 3 true) sp (|| "five" nil) sp (^^ true 10) ln)

# TODO contrast with true short circuit

(&& nil (print "trip-a" sp))
(|| true (print "trip-b" ln))
