# Check if functions are being called
# Expect: 1 2
# Expect: 3 4

# No args

(set 'do-print '(
	(set 'z x)
	(print z sp y ln)
))

(set 'x 1)
(set 'y 2)
(do-print)

(set 'x 3)
(set 'y 4)
(do-print)

# Args
# TODO: len

(set 'print-arg0 '(
	(print sp (len args) sp (get args 0))
))

(set 'print-arg0-wrap '(
	(print-arg0 1)
))

(set 'print-arg0-wrap-2 '(
	(print-arg0 (get args 1))
))

(print "args")
(print-arg0 'm1)
(print-arg0-wrap 'n2 'n3)
(print-arg0-wrap-2 'o4)
(print-arg0 'p1 'p2 'p3 'p4)
(print ln)

# Args -- complex

(set 'print-minus '(
	(print "in1" ln) # DEBUGGING-- REMOVE ME
	(print (- (get args 0) 1) sp (- (get args 1) 1) ln)
	(print "out1" ln) # DEBUGGING-- REMOVE ME
))

(set 'pass-on-minus '(
	(print "?? " (get args 0) sp (get args 1) sp (get args 2) ln) # DEBUGGING-- REMOVE ME
	((get args 0) (- (get args 1) 1) (- (get args 2) 1))
))

(set 'pass-on-minus-2 '(
	((get args 0) (- (get args 1) 1) (- (get args 2) 1))
	((get args 0) (- (get args 1) 2) (- (get args 2) 2))
))

# Test basic args...
(print-minus 1 2)

# Test args in nested call...
(pass-on-minus print-minus 4 5)

