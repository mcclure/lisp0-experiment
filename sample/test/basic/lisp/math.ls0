# Expect: 6 7 38
# Expect: 6
# Expect: 1
# Expect: 0 9 -10 -5
# Expect: -5 5 11 7

# Expect: [nil] [true] [nil] [nil] [true]
# Expect: [true] [nil] [nil] [true] [nil] [true]

# Expect: [nil] [true]
# Expect: [true] [nil]
# Expect: [nil] [true]
# Expect: [true] [nil]
# Expect: [nil] [true]
# Expect: [true] [nil] [nil]

# Expect: 3 [nil]
# Expect: [true] [true] [nil]
# Expect: trip-a trip-b

# ARITHMETIC

(print 6 sp (+ 1 6) sp (+ (+ 2 (+ 1 5)) (+ 10 20)) ln)
(print (* (- 7 4 1) (+ 1 (/ 16 4 2))) ln) # Reduces to (* 2 3)
(print (% 16 5) ln)
(print (+ 1 -1) sp (- -1 -10) sp (* 5 -2) sp (/ -10 2) ln)

# BITS

(print (neg 5) sp (neg -5) sp (& 15 (~ 4)) sp (| 3 6) ln)

# LOGIC

(print (&& true nil) sp (|| nil true) sp (&& true nil true) sp (|| nil nil nil) sp (! nil) ln)
(print (^^ nil true) sp (^^ nil nil) sp (^^ true true) sp (^^ true nil) sp (^^ true nil true) sp (^^ true true true) ln)

# EQUALITY

(print (= 1 3) sp (!= 1 3) ln)
(print (= 1 1) sp (!= 1 1) ln)
(print (= "aye" "bee") sp (!= "aye" "bee") ln)
(print (= "cee" "cee") sp (!= "dee" "dee") ln)
(print (= 1 "1") sp (!= 1 "1") ln)
(print (= 1 1 1) sp (= 1 2 3 4) sp (= 1 1 1 2) ln)

# ODDITIES AND SHORT CIRCUITING

(print (return 3) sp (discard 3 4 5 3 4) ln)

# TODO make arg 3 an array

(print (&& 3 true) sp (|| "five" nil) sp (^^ true 10) ln)

# TODO contrast with true short circuit

(&& nil (print "trip-a" sp))
(|| true (print "trip-b" ln))
