# Convoluted expressions to test reader edge cases.
# Arg: --debug-ast
# Expect: ("a", ("b", "c"), ("make-array-at", '(), "d", "e", ("f", "g"), ("h", "i"), ("j"), ("make-array-at", '(), "k"), ("make-array-at", '(), "l"), ("make-array-at", '(), "l2", ("l3", "l4", "l5"), "l6"), '("m"), '("m2", ("m3", "m4", "m5"), "m6", "m7"), ("make-array-at", '(), "n", "o", "p", ("q", "r"), "s", "t")))

a # comment
(b c) # comment
[ # comment
 d #comment
    e
    f \
    g
    h \ # comment
    i
    # Spaces after backslash
    (j \   
    )
    [ \
    k
    ]
    [ \
# comment
    l
    ]

    [ \
# comment
    l2
    l3 l4 l5
    l6
    ]

    { \

    # comment

    m
    }

    { \

    # comment

    m2,m3 m4 m5,
    m6,
    m7
    }


    [
      n, o,p
      q  \    
      r,s,

#comment
      t,
    ]
]
